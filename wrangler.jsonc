// Deploy-button entry point. Keep runtime resources in sync with
// workers/api/wrangler.jsonc. GROWTH is intentionally omitted because
// Deploy to Cloudflare does not auto-provision Analytics Engine datasets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "babili",
  "main": "workers/api/src/index.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "babili.datumoj.com",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-04-08",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 8799
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "AVATARS",
      "id": "077c7e00989448f5abdfd5d26aeb0248"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_OBJECT",
        "class_name": "RoomDurableObject"
      },
      {
        "name": "SQUARE",
        "class_name": "SquareDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SquareDurableObject"]
    }
  ]
}
